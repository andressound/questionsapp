# Copia este archivo a .env y ajusta los valores. .env no se sube al repositorio.
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=questionsapp
DB_PASSWORD=questionsapp_local_password
DB_NAME=questionsapp
TZ=UTC
# Opcionales (nube): DATABASE_URL tiene prioridad sobre DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=postgres://usuario:clave@host:5432/questionsapp
# DB_SSL=true
# DB_POOL_MAX=5
# Código que piden los profesores al registrarse desde la app (vacío = desactivado).
# Usa un valor largo y aleatorio, por ejemplo: openssl rand -base64 18
# TEACHER_SIGNUP_CODE=
